[branch]
  sort = -committerdate

[core]
  excludesFile = ~/.config/git/ignore

[diff]
  colorMoved = default

[include]
  path = ~/.gitconfig.local

[init]
  defaultBranch = main

[merge]
  conflictstyle = diff3

[pull]
  ff = only

[push]
  default = current

[rebase]
  autosquash = true
  autostash = true

[rerere]
  enabled = true

[safe]
	directory = /workspace
